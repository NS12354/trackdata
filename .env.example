# Copy to .env and fill in. All values have sane defaults for local dev.
# For the Docker stack, use .env.docker.example instead.

# --- Environment ---
# development | production. Production enforces API auth and uses Alembic
# migrations (not auto-create). A production start without API_KEY is refused.
ENVIRONMENT=development

# --- Database ---
# SQLite for local dev; a postgresql+psycopg2:// URL in production.
# DATABASE_URL=sqlite:///./data/revisent.db
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# --- Job queue (Celery + Redis) ---
# REDIS_URL=redis://localhost:6379/0
# Run tasks inline without a broker (dev/tests):
# CELERY_TASK_ALWAYS_EAGER=false
# TASK_MAX_RETRIES=3

# --- Storage ---
# STORAGE_BACKEND=local
# DATA_DIR=./data

# --- Uploads ---
# MAX_UPLOAD_BYTES=5368709120   # 5 GB
# VALIDATE_UPLOAD_CONTENT=true  # magic-byte sniff, not just extension

# --- Security ---
# When set, all /api routes require the X-API-Key header (or ?api_key= for the
# <video> stream). Always enforced in production.
# API_KEY=
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Privacy ---
# Keep raw uploads after anonymization (dev/debug). Set false to delete raw
# footage once anonymization succeeds (recommended for real footage).
RETAIN_RAW_UPLOADS=true

# --- Anonymization (face blurring) ---
# FACE_DETECTOR=union           # union | yunet | mediapipe
# FACE_DETECTION_MAX_DIM=960    # detect on a downscaled copy (0 = full res)
# FACE_DETECTION_STRIDE=2       # detect every Nth frame (gap-fill bridges rest)
# Confirmation thresholds (a track is blurred only if it has a strong detection):
# FACE_CONFIRM_CONFIDENCE=0.74  # MediaPipe scale
# YUNET_CONFIRM_SCORE=0.80      # YuNet scale
# BLUR_STRENGTH=0.6
# FACE_BOX_PADDING=0.2

# --- Hand pose (MediaPipe Hands) ---
# HAND_POSE_SAMPLE_FPS=10
# Detection/tracking confidence: the code default (0.1) is recall-tuned for
# blurry, gloved, fast industrial footage. For clean well-lit footage set 0.5 -
# it eliminates phantom-hand detections at the cost of a few missed frames
# (the 0.3s gap-fill bridges most of those).
# HAND_POSE_MIN_DETECTION_CONFIDENCE=0.5
# HAND_POSE_MIN_TRACKING_CONFIDENCE=0.5
# HAND_POSE_SWAP_HANDEDNESS=true

# --- Camera mount (body pose geometry & provenance) ---
# Where the wearable camera sits. "chest" = VO measures torso orientation;
# "head" = forehead-mounted, VO measures HEAD orientation (torso gets a
# yaw-only heading proxy at reduced confidence). Set this to match your rig.
# CAMERA_MOUNT=chest              # chest | head
# Head (forehead) mount geometry, fractions of operator height from the pelvis:
# EGO_HEAD_MOUNT_HEIGHT_FRAC=0.42
# EGO_HEAD_MOUNT_FORWARD_FRAC=0.05
# EGO_HEAD_MOUNT_PITCH_DEG=20

# --- Observability ---
# LOG_LEVEL=INFO
# LOG_JSON=false                # true for structured JSON logs in production
# METRICS_ENABLED=true          # Prometheus metrics at /metrics

# --- Activity description & segmentation (Phase 3) ---
# SEGMENTATION_MODE=open          # open (activity + commentary) | taxonomy (waste tasks)
# Provider: "ollama" = free local vision model (no data egress); "claude" = paid API.
# SEGMENTATION_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_VLM_MODEL=qwen2.5vl:3b   # sharper default; moondream = lighter/faster
# OLLAMA_USE_JSON=false           # true for capable models in taxonomy mode
# SEGMENTATION_SAMPLE_FPS=1.0

# --- LeRobot export (Phase 7) ---
# "segment" = one episode per annotated activity with the VLM description as
# the task string (language-conditioned VLA training). "clip" = one episode
# per whole video.
# LEROBOT_EPISODE_MODE=segment
# Drop episodes with almost no measured-hand frames (0 disables):
# LEROBOT_MIN_HAND_FRACTION=0.05

# --- Camera FOV (wrist-depth accuracy) ---
# FOV is auto-inferred from the recording device (iPhone/GoPro presets) unless
# a checkerboard calibration exists (scripts/calibrate_camera.py — always wins).
# Set EGO_CAMERA_FOV_DEG explicitly if you shoot with a non-default lens (0.5x).
# EGO_CAMERA_FOV_AUTO=true
# The wearer's real palm length (wrist crease -> middle-finger base knuckle,
# measured once with a ruler). Removes MediaPipe's generic hand-size error
# from wrist depth (+/-5-10%) and corrects metric grasp aperture:
# WEARER_PALM_LENGTH_CM=10.5
# EGO_CAMERA_FOV_DEG=90

# --- Chatbot (Phase 6) ---
# CHAT_PROVIDER=ollama            # ollama (local, free) | claude (paid)
# CHAT_MODEL=llama3.1:8b          # a text LLM you have pulled in Ollama

# --- Anthropic API (Phase 3 'claude' provider; chatbot Phase 6 deferred) ---
# Only needed if SEGMENTATION_PROVIDER=claude. Local default costs nothing.
ANTHROPIC_API_KEY=
