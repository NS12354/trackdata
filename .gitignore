# --- Python ---
backend/.venv/
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# --- Node / Next.js ---
frontend/node_modules/
frontend/.next/
frontend/out/
*.tsbuildinfo
next-env.d.ts

# --- Env / secrets (keep the *.example templates) ---
.env
.env.*
!.env.example
!.env.docker.example
!.env.local.example
frontend/.env.local

# --- Private data: NEVER commit footage or the DB ---
# Keep the directory structure (.gitkeep) but ignore all contents.
data/uploads/*
data/anonymized/*
data/processed/*
data/exports/*
data/*.db
!data/**/.gitkeep

# --- ML model weights (fetched via scripts/fetch_models.py) ---
backend/ml_models/*.onnx

# --- Local config for serve_public.sh (persisted key + ngrok domain) ---
backend/.serve_api_key
backend/.serve_ngrok_domain

# --- Local scratch / heavy artifacts: NEVER commit ---
# Throwaway virtualenvs (multi-GB) built by experiment scripts
data/tmp_wilor_env/
data/tmp_lerobot_env/
data/tmp_*_env/
# Redis on-disk dumps + DB snapshots
data/redis/
*.rdb
# Demo footage (private data, large)
data/demo/
# Misc scratch outputs from one-off experiments
data/worker.log
data/tmp_wilor_*.jsonl
data/wilor_compare.png
data/wilor_test_frame.png
data/wilor_bootstrap.py
data/mp_frame.json
data/mp_seg.json

# --- OS / editor ---
.DS_Store
*.swp
.vscode/
