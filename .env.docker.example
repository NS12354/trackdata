# Copy to .env for `docker compose up`. Set real secrets before any non-local use.

# --- Postgres ---
POSTGRES_USER=revisent
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=revisent

# --- API security ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# When set, all /api routes require the X-API-Key header. REQUIRED in production.
API_KEY=
# Comma-separated allowed frontend origins.
CORS_ORIGINS=http://localhost:3000

# --- Concurrency ---
WEB_CONCURRENCY=2
CELERY_CONCURRENCY=2

# --- Anthropic (Phases 3 & 6) ---
ANTHROPIC_API_KEY=
